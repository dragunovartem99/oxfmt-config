{
	"name": "@dragunovartem99/oxfmt-config",
	"version": "2.2.0",
	"description": "Personal oxfmt Config",
	"keywords": [
		"code-style",
		"configuration",
		"formatting",
		"oxfmt"
	],
	"homepage": "https://github.com/dragunovartem99/oxfmt-config#readme",
	"bugs": {
		"url": "https://github.com/dragunovartem99/oxfmt-config/issues"
	},
	"license": "MIT",
	"author": {
		"name": "Artem Dragunov",
		"email": "dragunovartem99@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dragunovartem99/oxfmt-config.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "dist/index.js",
	"exports": {
		".": "./dist/index.js",
		"./prettier": "./dist/prettier.js"
	},
	"scripts": {
		"build": "vite build",
		"format": "oxfmt --write",
		"format:check": "oxfmt --check",
		"lint": "oxlint --fix",
		"lint:check": "oxlint",
		"prepare": "husky",
		"prepublishOnly": "npm run build",
		"types:check": "tsc --noEmit"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@dragunovartem99/oxlint-config": "^3.0.1",
		"husky": "^9.1.7",
		"oxlint": "^1.85.0",
		"typescript": "~7.0.0",
		"vite": "^8.1.0"
	},
	"peerDependencies": {
		"oxfmt": ">=0.56.0"
	}
}
