	},
	"license": "MIT",
	"author": {
		"name": "Artem Dragunov",
		"email": "dragunovartem99@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dragunovartem99/oxfmt-config.git"
	},
	"main": ".oxfmtrc.json",
	"scripts": {
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"postinstall": "ln -sf node_modules/@dragunovartem99/oxfmt-config/.oxfmtrc.json $INIT_CWD/.oxfmtrc.json"
	},
	"peerDependencies": {
		"oxfmt": ">=0.35.0"
	}
